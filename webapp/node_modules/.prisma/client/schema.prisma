generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
  STUDY_CENTER
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum AnswerState {
  UNANSWERED
  ANSWERED
  MARKED_FOR_REVIEW
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_SELECT
  TRUE_FALSE
  SHORT_ANSWER
}

enum GradingStatus {
  FULLY_GRADED
  PENDING_REVIEW
}

model User {
  id           Int      @id @default(autoincrement())
  role         Role
  name         String
  email        String   @unique
  passwordHash String
  contactNo    String?
  address      String?
  city         String?
  pincode      String?
  createdAt    DateTime @default(now())

  attempts      Attempt[]
  gradedAnswers Answer[]  @relation("GradedAnswers")

  ownedSubjects  Subject[]  @relation("OwnedSubjects")
  ownedTests     Test[]     @relation("OwnedTests")
  ownedQuestions Question[] @relation("OwnedQuestions")
}

model Subject {
  id      Int    @id @default(autoincrement())
  name    String
  ownerId Int? // null = admin/global; else owned by a STUDY_CENTER (test conductor) account
  owner   User?  @relation("OwnedSubjects", fields: [ownerId], references: [id])
  tests   Test[]
}

model Test {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?
  code             String   @unique
  subjectId        Int
  subject          Subject  @relation(fields: [subjectId], references: [id])
  ownerId          Int? // null = admin/global; else owned by a STUDY_CENTER (test conductor) account
  owner            User?    @relation("OwnedTests", fields: [ownerId], references: [id])
  durationMin      Int
  availableFrom    DateTime @default(now())
  availableTo      DateTime
  isPractice       Boolean  @default(false)
  isPublished      Boolean  @default(false)
  shuffleQuestions Boolean  @default(false)
  poolSize         Int? // null = use every attached question
  createdAt        DateTime @default(now())

  testQuestions TestQuestion[]
  attempts      Attempt[]
}

model Tag {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  questions Question[]
}

model Question {
  id                 Int          @id @default(autoincrement())
  ownerId            Int? // null = admin/global bank; else owned by a STUDY_CENTER (test conductor) account
  owner              User?        @relation("OwnedQuestions", fields: [ownerId], references: [id])
  type               QuestionType @default(SINGLE_CHOICE)
  text               String
  marks              Int          @default(1)
  negativeMarks      Int          @default(0) // SINGLE_CHOICE / TRUE_FALSE only
  allowPartialCredit Boolean      @default(false) // MULTI_SELECT only
  createdAt          DateTime     @default(now())

  options   Option[]
  tags      Tag[]
  testLinks TestQuestion[]
  answers   Answer[] // no cascade — blocks deleting a question with attempt history
}

model TestQuestion {
  id         Int      @id @default(autoincrement())
  testId     Int
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId Int
  question   Question @relation(fields: [questionId], references: [id]) // no cascade — blocks deleting a question still attached to a test

  order Int

  @@unique([testId, questionId])
  @@unique([testId, order])
}

model Option {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int

  selections AnswerOption[]
}

model Attempt {
  id            Int           @id @default(autoincrement())
  studentId     Int
  student       User          @relation(fields: [studentId], references: [id])
  testId        Int
  test          Test          @relation(fields: [testId], references: [id])
  startTime     DateTime      @default(now())
  deadline      DateTime
  endTime       DateTime?
  status        AttemptStatus @default(IN_PROGRESS)
  score         Float?
  gradingStatus GradingStatus @default(FULLY_GRADED)

  answers Answer[]

  @@unique([studentId, testId])
}

model Answer {
  id           Int         @id @default(autoincrement())
  attemptId    Int
  attempt      Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId   Int
  question     Question    @relation(fields: [questionId], references: [id])
  order        Int // per-attempt snapshot position (post shuffle/pool)
  state        AnswerState @default(UNANSWERED)
  textResponse String? // SHORT_ANSWER
  awardedMarks Float? // null = not yet gradable (pending manual review)
  gradedById   Int?
  gradedBy     User?       @relation("GradedAnswers", fields: [gradedById], references: [id])
  gradedAt     DateTime?
  timeSpentSec Int         @default(0) // item-analysis instrumentation, client-reported

  selections AnswerOption[]

  @@unique([attemptId, questionId])
  @@unique([attemptId, order])
}

model AnswerOption {
  id       Int    @id @default(autoincrement())
  answerId Int
  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  optionId Int
  option   Option @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([answerId, optionId])
}
